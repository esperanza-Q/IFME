<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05101D">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:padding="18dp"
            android:contentDescription="뒤로가기"
            android:src="@drawable/ic_node_create_back"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="노드 생성"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:letterSpacing="-0.025"
            android:textStyle="bold" />

        <Space
            android:layout_width="56dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/formScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="false"
        android:clipToPadding="false"
        android:paddingStart="26dp"
        android:paddingEnd="23dp"
        android:paddingBottom="24dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/bottomArea"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvParentNodeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="32dp"
                android:text="취업하기"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="STEP 0  선택지 이름"
                android:textColor="#5D7AFA"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNodeTitle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_node_create_input"
                android:hint="노드 이름을 작성하세요"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="35dp"
                android:layout_marginBottom="18dp"
                android:text="STEP 1  중요하게 생각하는 가치"
                android:textColor="#5D7AFA"
                android:textSize="16sp"
                android:textStyle="bold" />

            <GridLayout
                android:id="@+id/gridValues"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="5"
                android:rowCount="2" />

            <LinearLayout
                android:id="@+id/customValueArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etCustomValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="29dp"
                    android:gravity="center_vertical"
                    android:layout_weight="1"
                    android:background="@drawable/bg_node_create_custom"
                    android:hint="가치를 입력해주세요"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#33FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnAddValue"
                    android:layout_width="66dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_node_create_add"
                    android:gravity="center"
                    android:text="추가"
                    android:clickable="true"
                    android:focusable="true"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCustomValues"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#5D7AFA"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="39dp"
                android:text="STEP 2  기대하는 점"
                android:textColor="#5D7AFA"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etExpected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="117dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_node_create_input"
                android:gravity="top|start"
                android:hint="이 선택으로 얻을 것으로 예상되는 경험이나 성과를 작성하세요"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:inputType="textMultiLine|textCapSentences"
                android:paddingStart="16dp"
                android:paddingTop="17dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="39dp"
                android:text="STEP 3  걱정하는 점"
                android:textColor="#5D7AFA"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etConcern"
                android:layout_width="match_parent"
                android:layout_height="117dp"
                android:layout_marginTop="19dp"
                android:background="@drawable/bg_node_create_input"
                android:gravity="top|start"
                android:hint="예상되는 문제나 부담을 작성하세요"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:inputType="textMultiLine|textCapSentences"
                android:paddingStart="16dp"
                android:paddingTop="17dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:text="STEP 4  예상 만족도"
                android:textColor="#5D7AFA"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.example.ifme.SatisfactionSliderView
                android:id="@+id/satisfactionSlider"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="17dp"
                android:contentDescription="예상 만족도 슬라이더" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomArea"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:paddingStart="26dp"
        android:paddingEnd="23dp"
        android:gravity="center"
        android:background="#05101D"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnComplete"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center"
            android:background="@drawable/bg_node_create_complete"
            android:clickable="true"
            android:focusable="true"
            android:text="완료"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
