<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_create_world"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- 상단 헤더 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="뒤로가기"
            android:src="@drawable/ic_back_arrow" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/suite_regular"
            android:text="새 세계 만들기"
            android:textColor="#1A1A1A"
            android:textSize="17sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- 상단 3단계 진행 바 (1/3 활성화) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="#5363BE" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="#E8EAF2" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#E8EAF2" />
    </LinearLayout>

    <!-- 본문 스크롤 영역 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

            <!-- 메인 타이틀 & 서브타이틀 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/wavve_pado"
                android:text="어떤 갈림길에 서 있나요?"
                android:textColor="#1A1A1A"
                android:textSize="27sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/suite_regular"
                android:text="고민 중인 두 가지 메인 선택지를 적어주세요"
                android:textColor="#666666"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- 1. 세계 제목 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/suite_regular"
                android:text="세계 제목"
                android:textColor="#1A1A1A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_world_title"
                android:layout_width="match_parent"
                android:layout_height="39dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_create_input_box"
                android:fontFamily="@font/suite_regular"
                android:hint="ex) 취업하기 VS 대학원 진학하기"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textColor="#222222"
                android:textColorHint="#9E9E9E"
                android:textSize="13sp" />

            <!-- 2. 메인 노드 작성 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:fontFamily="@font/suite_regular"
                android:text="메인 노드 작성"
                android:textColor="#1A1A1A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 좌측 분기 그래픽 -->
                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="180dp"
                    android:contentDescription="분기 연결선"
                    android:scaleType="fitXY"
                    android:src="@drawable/ic_node_branch" />

                <!-- 우측 선택지 카드 2개 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- 선택지 1 카드 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="82dp"
                        android:background="@drawable/bg_create_node_card"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingHorizontal="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/suite_regular"
                            android:text="선택지1"
                            android:textColor="#5363BE"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/et_choice1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:background="@null"
                            android:fontFamily="@font/suite_regular"
                            android:hint="ex. 취업하기"
                            android:imeOptions="actionNext"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textColor="#222222"
                            android:textColorHint="#8E8E8E"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <!-- 선택지 2 카드 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="82dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_create_node_card"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingHorizontal="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/suite_regular"
                            android:text="선택지2"
                            android:textColor="#5363BE"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/et_choice2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:background="@null"
                            android:fontFamily="@font/suite_regular"
                            android:hint="ex. 대학원 진학하기"
                            android:imeOptions="actionNext"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textColor="#222222"
                            android:textColorHint="#8E8E8E"
                            android:textSize="16sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 3. 예상 기간 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:fontFamily="@font/suite_regular"
                android:text="예상 기간"
                android:textColor="#1A1A1A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <!-- 숫자 입력 -->
                <EditText
                    android:id="@+id/et_period_value"
                    android:layout_width="138dp"
                    android:layout_height="39dp"
                    android:background="@drawable/bg_create_period_box"
                    android:fontFamily="@font/suite_regular"
                    android:hint="숫자 입력"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLength="4"
                    android:maxLines="1"
                    android:paddingHorizontal="14dp"
                    android:textColor="#222222"
                    android:textColorHint="#9E9E9E"
                    android:textSize="13sp" />

                <!-- 단위 드롭다운 -->
                <RelativeLayout
                    android:layout_width="103dp"
                    android:layout_height="39dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_create_period_box"
                    android:elevation="2dp">

                    <Spinner
                        android:id="@+id/spinner_period_unit"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:paddingStart="12dp"
                        android:paddingEnd="28dp"
                        android:spinnerMode="dropdown"
                        tools:entries="@array/period_units_preview" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="단위 선택"
                        android:src="@drawable/ic_chevron_down" />
                </RelativeLayout>
            </LinearLayout>

            <!-- 하단 버튼 -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_next_main_node"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="34dp"
                android:background="@drawable/bg_create_cta_btn"
                android:fontFamily="@font/wavve_pado"
                android:stateListAnimator="@null"
                android:text="메인 노드 작성으로 넘어가기"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

        </LinearLayout>
    </ScrollView>

    <!-- 하단 네비게이션 바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="10dp">

        <!-- 월드 탭 (활성화) -->
        <LinearLayout
            android:id="@+id/nav_world"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="월드"
                android:src="@drawable/ic_nav_world"
                app:tint="#4460D1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/pretendard_bold"
                android:text="월드"
                android:textColor="#4460D1"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 홈 탭 -->
        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="홈"
                android:src="@drawable/ic_nav_home"
                app:tint="#BDBDBD" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/pretendard_regular"
                android:text="홈"
                android:textColor="#BDBDBD"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 마이 탭 -->
        <LinearLayout
            android:id="@+id/nav_my"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="마이"
                android:src="@drawable/ic_nav_my"
                app:tint="#BDBDBD" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/pretendard_regular"
                android:text="마이"
                android:textColor="#BDBDBD"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>