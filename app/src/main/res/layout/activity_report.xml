<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/reportRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#06070F">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_marginTop="20dp">

        <ImageButton
            android:id="@+id/reportBtnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="2dp"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back_black"
            app:tint="#FFFFFF"
            android:contentDescription="뒤로 가기" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="의사결정 리포트"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:fontFamily="@font/pretendard_semibold" />

    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="23dp">

            <LinearLayout
                android:id="@+id/reportMonthBox"
                android:orientation="horizontal"
                android:layout_width="157dp"
                android:layout_height="47dp"
                android:background="@drawable/bg_report_month"
                android:gravity="center_vertical"
                android:paddingHorizontal="24dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:id="@+id/reportMonthSelect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:letterSpacing="0.1"
                    android:fontFamily="@font/pretendard_bold"
                    tools:text="2026년 10월" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="9dp"
                    android:src="@drawable/ic_report_arrow_down"
                    android:contentDescription="달 선택" />

            </LinearLayout>

            <LinearLayout
                style="@style/ReportCard"
                android:layout_height="236dp"
                android:background="@drawable/bg_report_type_card"
                android:paddingVertical="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="이번 달 나의 선택 유형"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/suite_medium" />

                <TextView
                    android:id="@+id/reportTypeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:fontFamily="@font/wavve_pado"
                    android:lineSpacingExtra="2dp"
                    tools:text="성장을 따라가는\n탐험가" />

                <TextView
                    android:id="@+id/reportTypeDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@font/suite_medium"
                    android:lineSpacingExtra="4dp"
                    tools:text="불확실하더라도 새로운 경험을 주는\n길을 더 자주 골랐어요." />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <LinearLayout
                    android:id="@+id/reportTagList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </LinearLayout>

            <LinearLayout
                style="@style/ReportCard"
                android:layout_height="180dp"
                android:paddingVertical="20dp"
                android:background="@drawable/bg_report_ect_card">

                <TextView
                    style="@style/ReportCardTitle"
                    android:text="예상 만족도 vs 실제 만족도" />

                <TableLayout
                    android:id="@+id/reportSatisfactionTable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:stretchColumns="1" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <TextView
                    android:id="@+id/reportSatisfactionDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textColor="#E3E5FF"
                    android:textSize="12sp"
                    android:fontFamily="@font/suite_medium"
                    android:lineSpacingExtra="4dp"
                    tools:text="평균적으로 기대가 실제보다 0.9점 높았어요." />

            </LinearLayout>

            <LinearLayout
                style="@style/ReportCard"
                android:layout_height="170dp"
                android:paddingVertical="20dp"
                android:background="@drawable/bg_report_ect_card">

                <TextView
                    style="@style/ReportCardTitle"
                    android:text="선택할 때 중요하게 여긴 가치" />

                <TableLayout
                    android:id="@+id/reportValueTable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:stretchColumns="1" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="187dp"
                android:layout_marginTop="23dp"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/ReportSmallCard"
                    android:paddingVertical="20dp"
                    android:background="@drawable/bg_report_ect_card">

                    <TextView
                        style="@style/ReportCardTitle"
                        android:text="걱정의 적중률" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <GridLayout
                        android:id="@+id/reportWorryDots"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:columnCount="4" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/reportWorryDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#E3E5FF"
                        android:textSize="12sp"
                        android:fontFamily="@font/suite_medium"
                        android:lineSpacingExtra="3dp"
                        tools:text="걱정 8개 중\n3개만 실제로 일어났어요" />

                </LinearLayout>

                <View
                    android:layout_width="12dp"
                    android:layout_height="0dp" />

                <LinearLayout
                    android:layout_gravity="center_vertical"
                    style="@style/ReportSmallCard"
                    android:paddingVertical="20dp"
                    android:background="@drawable/bg_report_ect_card">

                    <TextView
                        style="@style/ReportCardTitle"
                        android:text="다시 선택한다면" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="5dp"
                        android:baselineAligned="true">

                        <TextView
                            android:id="@+id/reportReselectSame"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:textSize="34sp"
                            android:fontFamily="@font/pretendard_bold"
                            tools:text="6" />

                        <TextView
                            android:id="@+id/reportReselectTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:textColor="#9A9DC7"
                            android:textSize="20sp"
                            android:fontFamily="@font/pretendard_bold"
                            tools:text="/ 8" />

                    </LinearLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/reportReselectDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#E3E5FF"
                        android:textSize="12sp"
                        android:fontFamily="@font/suite_medium"
                        android:lineSpacingExtra="3dp"
                        tools:text="회고에서 같은 선택을\n하겠다고 답했어요" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                style="@style/ReportCard"
                android:paddingVertical="20dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_report_ect_card">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_report_ai"
                        android:contentDescription="AI" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="AI 한 마디"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="@font/pretendard_semibold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/reportAiComment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="@font/suite_medium"
                    android:lineSpacingExtra="8dp"
                    tools:text="걱정은 대부분 일어나지 않았어요." />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/reportFooterContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF">

        <include
            layout="@layout/view_footer"
            android:layout_width="match_parent"
            android:layout_height="80dp" />

    </FrameLayout>

</LinearLayout>