<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mypageRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:paddingTop="20dp">

    <FrameLayout
        android:id="@+id/mypageHeader"
        android:layout_width="match_parent"
        android:layout_height="84dp">

        <ImageButton
            android:id="@+id/btnBackHome"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="2dp"
            android:paddingHorizontal="16dp"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back_black"
            android:contentDescription="뒤로 가기" />

        <ImageView
            android:id="@+id/mypageLogo"
            android:layout_width="93dp"
            android:layout_height="43dp"
            android:layout_gravity="center"
            android:src="@drawable/img_mypage_logo" />

    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <FrameLayout
            android:id="@+id/mypageCardProfile"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bg_mypage_profile_box"
            android:paddingStart="30dp"
            android:paddingEnd="20dp"
            android:paddingTop="25dp"
            android:paddingBottom="11dp"
            app:layout_constraintDimensionRatio="379:234"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/mypageProfileTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:text="회원정보"
                android:fontFamily="@font/wavvepado_regular"
                android:textSize="24sp"
                android:letterSpacing="0.1"
                android:textColor="@color/purple1" />

            <TextView
                android:id="@+id/mypageProfileContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginTop="47dp"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/suite_bold"
                android:textSize="15sp"
                android:lineHeight="30sp"
                android:letterSpacing="0.05"
                android:text="이름  |  홍길동\n이메일  |  example@gmail.com\n기록 히스토리  |  2026.05.12 ~" />

            <ImageButton
                android:id="@+id/mypageBtnEdit"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="bottom|end"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_mypage_pencil"
                android:scaleType="fitCenter"
                android:contentDescription="회원정보 수정" />

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mypageCardCount"
        android:layout_width="match_parent"
        android:layout_height="94dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="30dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="12dp"
        app:strokeColor="#EEEFF0"
        app:strokeWidth="1.2dp"
        app:cardElevation="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:layout_marginStart="60dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:text="진행 중인 세계"
                    android:textColor="@color/purple1"
                    android:textSize="14sp"
                    android:fontFamily="@font/pretendard_bold" />

                <TextView
                    android:id="@+id/mypageIngressCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:text="5"
                    android:textSize="24sp"
                    android:fontFamily="@font/pretendard_semibold" />

            </FrameLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:layout_marginEnd="60dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:text="완료한 세계"
                    android:textColor="@color/purple1"
                    android:textSize="14sp"
                    android:fontFamily="@font/pretendard_bold" />

                <TextView
                    android:id="@+id/mypageEndCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:text="7"
                    android:textSize="24sp"
                    android:fontFamily="@font/pretendard_semibold" />

            </FrameLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:id="@+id/mypageReport"
        android:layout_width="347dp"
        android:layout_height="71dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="30dp">

        <Button
            android:id="@+id/mypageBtnReport"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_mypage_button_round"
            app:backgroundTint="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="64dp"
            android:text="나의 의사결정 리포트 보러 가기"
            android:textColor="@color/white"
            android:fontFamily="@font/pretendard_bold" />

        <ImageView
            android:layout_width="10dp"
            android:layout_height="19dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="64dp"
            android:src="@drawable/ic_mypage_report" />

    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <include
        android:id="@+id/mypageFooter"
        layout="@layout/view_footer"
        android:layout_width="match_parent"
        android:layout_height="80dp" />

</LinearLayout>