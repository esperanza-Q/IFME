<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05101D">

    <!-- 뒤로가기 -->
    <TextView
        android:id="@+id/btnTreeBack"
        android:layout_width="48dp"
        android:layout_height="64dp"
        android:gravity="center"
        android:text="‹"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 세계 제목 -->
    <TextView
        android:id="@+id/tvWorldTitle"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:gravity="center"
        android:text="세계 제목"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 확대 및 이동 영역 -->
    <com.example.ifme.ZoomableTreeLayout
        android:id="@+id/zoomableTree"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvWorldTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 동적 트리 컨테이너 -->
        <FrameLayout
            android:id="@+id/treeContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- 노드 연결선 -->
            <com.example.ifme.TreeConnectionView
                android:id="@+id/treeConnections"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </FrameLayout>

    </com.example.ifme.ZoomableTreeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
