<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_node_card"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp">

            <TextView
                android:id="@+id/tv_branch_number"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="제 1 분기점"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_node_status_chip"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="선택 전"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingStart="20dp"
            android:text="취업하기"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:background="@drawable/bg_node_card_inner"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/NodeLabelChip"
                android:text="중요하게 생각하는 가치" />

            <LinearLayout
                android:id="@+id/layout_values"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal" />

            <TextView
                style="@style/NodeLabelChip"
                android:layout_marginTop="10dp"
                android:text="기대하는 점" />

            <TextView
                android:id="@+id/tv_expect"
                style="@style/NodeBodyText"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                style="@style/NodeLabelChip"
                android:text="걱정하는 점" />

            <TextView
                android:id="@+id/tv_worry"
                style="@style/NodeBodyText"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                style="@style/NodeLabelChip"
                android:text="포기해야할 것" />

            <TextView
                android:id="@+id/tv_give_up"
                style="@style/NodeBodyText"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/NodeLabelChip"
                    android:text="예상 만족도" />

                <TextView
                    android:id="@+id/tv_satisfaction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="7/10"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>