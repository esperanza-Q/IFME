<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- 상단 및 중앙 스크롤 영역 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingHorizontal="26dp"
            android:paddingTop="32dp"
            android:paddingBottom="24dp">

            <!-- 브랜드 로고 -->
            <TextView
                android:id="@+id/tv_home_logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/playfair_display_bold"
                android:text="If : Me"
                android:textColor="#151E43"
                android:textSize="24sp" />

            <!-- 메인 질문 문구 (Wavve PADO) -->
            <TextView
                android:id="@+id/tv_home_headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/wavve_pado"
                android:lineSpacingExtra="4dp"
                android:text="오늘은 어떤\n갈림길에 서 있나요?"
                android:textColor="#000000"
                android:textSize="24sp" />

            <!-- 새 세계 만들기 카드 -->
            <LinearLayout
                android:id="@+id/card_create_world"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_home_create_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="108dp"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp"
                android:paddingVertical="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pretendard_bold"
                        android:text="새 세계 만들기"
                        android:textColor="#000000"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tv_create_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/suite_regular"
                        android:lineSpacingExtra="3dp"
                        android:text="고민 중인 두 가지 선택지로\nIf:Me와 평행세계를 시작해 보세요!"
                        android:textColor="#767676"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- 보라색 원형 + 버튼 (54dp × 54dp) -->
                <TextView
                    android:id="@+id/btn_create_plus"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_home_plus_btn"
                    android:contentDescription="새 세계 만들기"
                    android:elevation="4dp"
                    android:fontFamily="@font/suite_medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="+"
                    android:textColor="#FFFFFF"
                    android:textSize="40sp" />
            </LinearLayout>

            <!-- 최근 나의 세계 섹션 타이틀 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:fontFamily="@font/wavve_pado"
                android:text="최근 나의 세계"
                android:textColor="#000000"
                android:textSize="24sp" />

            <!-- 최근 세계 카드 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_home_world_card"
                android:elevation="6dp"
                android:gravity="center_vertical"
                android:minHeight="114dp"
                android:orientation="vertical"
                android:outlineAmbientShadowColor="#40000000"
                android:outlineSpotShadowColor="#40000000"
                android:paddingHorizontal="18dp"
                android:paddingTop="16dp"
                android:paddingBottom="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/pretendard_semibold"
                        android:text="내 미래 세계"
                        android:textColor="#000000"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pretendard_semibold"
                        android:text="2026.XX.XX"
                        android:textColor="#C5C8CE"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/suite_regular"
                    android:text="대학원 가기 vs 취업 하기"
                    android:textColor="#4E5660"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pretendard_semibold"
                        android:text="노드 수 · "
                        android:textColor="#6E757D"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pretendard_bold"
                        android:text="k개"
                        android:textColor="#4460D1"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 최근 세계 카드 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_home_world_card"
                android:elevation="6dp"
                android:gravity="center_vertical"
                android:minHeight="114dp"
                android:orientation="vertical"
                android:outlineAmbientShadowColor="#40000000"
                android:outlineSpotShadowColor="#40000000"
                android:paddingHorizontal="18dp"
                android:paddingTop="16dp"
                android:paddingBottom="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/pretendard_semibold"
                        android:text="내 미래 세계"
                        android:textColor="#000000"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pretendard_semibold"
                        android:text="2026.XX.XX"
                        android:textColor="#C5C8CE"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/suite_regular"
                    android:text="대학원 가기 vs 취업 하기"
                    android:textColor="#4E5660"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pretendard_semibold"
                        android:text="노드 수 · "
                        android:textColor="#6E757D"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pretendard_bold"
                        android:text="k개"
                        android:textColor="#4460D1"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 최근 세계 카드 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_home_world_card"
                android:elevation="6dp"
                android:gravity="center_vertical"
                android:minHeight="114dp"
                android:orientation="vertical"
                android:outlineAmbientShadowColor="#40000000"
                android:outlineSpotShadowColor="#40000000"
                android:paddingHorizontal="18dp"
                android:paddingTop="16dp"
                android:paddingBottom="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/pretendard_semibold"
                        android:text="내 미래 세계"
                        android:textColor="#000000"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pretendard_semibold"
                        android:text="2026.XX.XX"
                        android:textColor="#C5C8CE"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/suite_regular"
                    android:text="대학원 가기 vs 취업 하기"
                    android:textColor="#4E5660"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pretendard_semibold"
                        android:text="노드 수 · "
                        android:textColor="#6E757D"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pretendard_bold"
                        android:text="k개"
                        android:textColor="#4460D1"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 공통 하단 네비게이션 바 -->
    <include
        android:id="@+id/mypageFooter"
        layout="@layout/view_footer"
        android:layout_width="match_parent"
        android:layout_height="80dp" />

</LinearLayout>