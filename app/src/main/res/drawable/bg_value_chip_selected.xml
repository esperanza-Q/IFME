<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 안쪽 그림자 베이스 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="50dp" />
            <solid android:color="#6E7BB1" />
        </shape>
    </item>

    <!-- 메인 채우기 (#4460D1 61% -> #8D9EE3, 상단 3dp 내려서 안쪽 그림자 표현) -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="50dp" />
            <solid android:color="#8D9EE3" />
        </shape>
    </item>

    <!-- 외곽선 (#4460D1, 1dp) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="50dp" />
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="#4460D1" />
        </shape>
    </item>

</layer-list>